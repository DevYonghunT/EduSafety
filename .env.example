# PostgreSQL
DATABASE_URL=postgresql://edusafety:change-me@127.0.0.1:5432/edusafety

# EAS Offchain v2 fixed configuration
EAS_CHAIN_ID=84532
EAS_SCHEMA_UID=0xf58b8b212ef75ee8cd7e8d803c37c03e0519890502d5e99ee2412aae1456cafe
EAS_ATTESTER_ADDRESS=
EAS_ATTESTER_PRIVATE_KEY=
EAS_TRUSTED_ATTESTER_ADDRESSES=

# Exact comma-separated cross-origin allowlist. Same-origin requests are handled separately.
BADGE_ALLOWED_ORIGINS=http://localhost:5174
BADGE_PUBLIC_BASE_URL=http://localhost:5174
BADGE_EXPIRATION_DAYS=365

# Server-verified administrator account
ADMIN_ID=local-administrator
ADMIN_USERNAME=admin@example.test
ADMIN_PASSWORD_SCRYPT=
ADMIN_SESSION_SECRET=

# Optional. Recommended to increase GitHub REST API limits.
GITHUB_TOKEN=

# Optional passive URL source check. Set true to allow targets outside the fixed origin allowlist.
SECURITY_SCAN_DYNAMIC_TARGETS_ENABLED=false

# Optional legacy fixed-target mode. Exact HTTPS origins only, comma-separated.
# Used as the target boundary while dynamic URL input is disabled.
# Example: https://school-app.example,https://review.example
SECURITY_SCAN_ALLOWED_ORIGINS=
SECURITY_SCAN_TIMEOUT_MS=5000

# Server
NODE_ENV=development
PORT=3000
