{
  "name": "edusafety",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "EduSafety review app and EAS Offchain v2 gasless signed certification service",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build && node scripts/copy-client-public.mjs",
    "build:server": "tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "start": "node server-dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:db": "vitest run tests/integration/postgres.test.ts",
    "test:vercel": "vercel build && vitest run tests/integration/vercel-build-output.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "admin:hash-password": "tsx src/auth/hash-password.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "cookie": "^1.0.2",
    "dotenv": "^17.4.2",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.34.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.11.0",
    "pg-mem": "^3.0.5",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.11"
  }
}
