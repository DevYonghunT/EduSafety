{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:client",
  "outputDirectory": "client-dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/server.ts": {
      "includeFiles": "public/**",
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/server?__edusafety_path=/api"
    },
    {
      "source": "/api/:__edusafety_route*",
      "destination": "/api/server?__edusafety_path=/api/:__edusafety_route*"
    },
    {
      "source": "/health",
      "destination": "/api/server?__edusafety_path=/health"
    },
    {
      "source": "/admin/certification",
      "destination": "/api/server?__edusafety_path=/admin/certification"
    },
    {
      "source": "/admin-certification",
      "destination": "/api/server?__edusafety_path=/admin-certification"
    },
    {
      "source": "/admin-certification.html",
      "destination": "/api/server?__edusafety_path=/admin-certification.html"
    },
    {
      "source": "/admin/login",
      "destination": "/admin-login"
    },
    {
      "source": "/verify/:uid",
      "destination": "/verify"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; connect-src 'self' https://api.github.com https://raw.githubusercontent.com https://api.anthropic.com; img-src 'self' data:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
